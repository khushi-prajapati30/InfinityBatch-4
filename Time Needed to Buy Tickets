class Solution {
    public int timeRequiredToBuy(int[] tickets, int k) {
        Queue<Integer> q = new LinkedList<>();
        int n = tickets.length;
        
        for(int i=0; i<n; i++){
            q.add(i);
        }
        int c = 0;
        while(tickets[k] > 0){
            int idx = q.poll();
            if(tickets[idx] > 0){
                c++;
                tickets[idx]--;
            }
            if(tickets[idx] > 0) q.add(idx);
        }
        return c;
    }
}
