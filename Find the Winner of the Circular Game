class Solution {
    public int findTheWinner(int n, int k) {
        List<Integer> list = new ArrayList<>();
        for(int i=1;i<=n;i++){
            list.add(i);
        }
        int j = 0;
        while(list.size()>1){
            int next = (j+k-1)%list.size();
            list.remove(next);
            j = next;
        }
        return list.get(0);
    }
}
